# Nexa Environment Variables
# Copy this file to .env and fill in your values

# Security (REQUIRED: change in production)
SECRET_KEY=nexa-dev-secret-change-in-production

# Database
# PostgreSQL: postgresql://user:pass@host:5432/dbname
# SQLite (dev): sqlite:///./nexa.db
DATABASE_URL=sqlite:///./nexa.db

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM provider switch: deepseek | moonshot
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Kimi / Moonshot (OpenAI-compatible)
MOONSHOT_API_KEY=sk-your-kimi-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k3

# Optional manual override. Leave empty unless debugging.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=100
